# Example environment file (DO NOT PUT REAL SECRETS)
# Copy to .env and fill in real values for deployment.

# Core
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/vocelio

# Redis
REDIS_URL=redis://redis:6379/0

# JWT / Auth (generate new secure values for production)
JWT_SECRET_KEY=change_me_generate_long_random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Active Service URLs
OVERVIEW_SERVICE_URL=http://overview-service:8001
AI_AGENTS_SERVICE_URL=http://ai-agents-service:8002
SMART_CAMPAIGNS_SERVICE_URL=http://smart-campaigns-service:8003

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# External APIs (fill in per environment)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=support@vocelio.ai

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
