## Example Environment Configuration (sanitized)
## Copy to .env and populate with real secrets locally only (never commit real values).

# ---------------------------------------------------------------------------
# Core Application
# ---------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@postgres:5432/vocelio
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Redis / Caching
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# JWT / Auth (Generate secure random values for production)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_generate_long_random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SECRET_KEY=change_me_generate_long_random

# ---------------------------------------------------------------------------
# AI Provider Keys (Optional Locally)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
RAMBLE_API_KEY=

# ---------------------------------------------------------------------------
# External Integrations
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# CORS / Hosts
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Service URLs - Railway Production (Updated with Latest Deployments)
# ---------------------------------------------------------------------------
# Original Services
OVERVIEW_SERVICE_URL=https://overview-production.up.railway.app
AI_AGENTS_SERVICE_URL=https://ai-agents-service-production.up.railway.app
AGENTS_SERVICE_URL=https://agents-production-768d.up.railway.app
SMART_CAMPAIGNS_SERVICE_URL=https://smart-campaigns-production.up.railway.app
PHONE_NUMBERS_SERVICE_URL=https://phone-numbers-production.up.railway.app
ANALYTICS_SERVICE_URL=https://analytics-pro-production.up.railway.app
TEAM_HUB_SERVICE_URL=https://team-hub-production.up.railway.app

# New Services - Recently Deployed
CALL_CENTER_SERVICE_URL=https://call-center-production-19af.up.railway.app
VOICE_MARKETPLACE_SERVICE_URL=https://voice-marketplace-production.up.railway.app
VOICE_LAB_SERVICE_URL=https://voice-lab-production.up.railway.app
FLOW_BUILDER_SERVICE_URL=https://flow-builder-production.up.railway.app
AI_BRAIN_SERVICE_URL=https://ai-brain-production.up.railway.app
INTEGRATIONS_SERVICE_URL=https://integrations-production-a079.up.railway.app
AGENT_STORE_SERVICE_URL=https://agent-store-production.up.railway.app
BILLING_SERVICE_URL=https://billing-pro-production.up.railway.app
COMPLIANCE_SERVICE_URL=https://compliance-production-a432.up.railway.app
WHITE_LABEL_SERVICE_URL=https://white-label-production-ab67.up.railway.app
DEVELOPER_API_SERVICE_URL=https://developer-api-production-a124.up.railway.app
SETTINGS_SERVICE_URL=https://settings-production.up.railway.app

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# ---------------------------------------------------------------------------
# Monitoring & Metrics
# ---------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=support@vocelio.ai

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
RAILWAY_ENVIRONMENT=development
PORT=8000
PROMETHEUS_PORT=9090
