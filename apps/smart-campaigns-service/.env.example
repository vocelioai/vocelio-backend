# 📊 Vocelio.ai Smart Campaigns Service Environment Configuration

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=vocelio

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Service Configuration
SERVICE_PORT=8003
SERVICE_HOST=0.0.0.0
LOG_LEVEL=info

# API Gateway Configuration
API_GATEWAY_URL=http://localhost:8000

# Security
SECRET_KEY=your_super_secure_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Campaign Configuration
DEFAULT_DAILY_CALL_LIMIT=1000
MAX_CAMPAIGNS_PER_USER=100
AB_TEST_MIN_DURATION_DAYS=3
AB_TEST_MAX_DURATION_DAYS=30

# Optimization Settings
AI_OPTIMIZATION_ENABLED=true
AUTO_OPTIMIZATION_THRESHOLD=0.8
PERFORMANCE_UPDATE_INTERVAL=300

# Environment
ENVIRONMENT=development
