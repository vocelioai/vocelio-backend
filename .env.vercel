# Vocelio AI - Vercel Environment Variables
# Add these to your Vercel project environment variables

# World-Class AI Services Backend URLs
NEXT_PUBLIC_KNOWLEDGE_BASE_URL=https://knowledge-base-production.up.railway.app
NEXT_PUBLIC_LEAD_MANAGEMENT_URL=https://lead-management-production.up.railway.app
NEXT_PUBLIC_NOTIFICATIONS_URL=https://notifications-production.up.railway.app
NEXT_PUBLIC_SCHEDULING_URL=https://scheduling-production.up.railway.app
NEXT_PUBLIC_SCRIPTS_URL=https://scripts-production.up.railway.app
NEXT_PUBLIC_WEBHOOKS_URL=https://webhooks-production.up.railway.app

# Core Services URLs
NEXT_PUBLIC_API_GATEWAY_URL=https://api-gateway-production-588d.up.railway.app
NEXT_PUBLIC_TEAM_HUB_URL=https://team-hub-production.up.railway.app
NEXT_PUBLIC_OVERVIEW_URL=https://overview-production.up.railway.app
NEXT_PUBLIC_ANALYTICS_URL=https://analytics-pro-production.up.railway.app
NEXT_PUBLIC_SMART_CAMPAIGNS_URL=https://smart-campaigns-production.up.railway.app
NEXT_PUBLIC_PHONE_NUMBERS_URL=https://phone-numbers-production.up.railway.app

# Additional Services URLs  
NEXT_PUBLIC_AGENTS_URL=https://agents-production.up.railway.app
NEXT_PUBLIC_AI_AGENTS_URL=https://ai-agents-service-production.up.railway.app
NEXT_PUBLIC_AGENT_STORE_URL=https://agent-store-production.up.railway.app
NEXT_PUBLIC_AI_BRAIN_URL=https://ai-brain-production.up.railway.app
NEXT_PUBLIC_BILLING_URL=https://billing-pro-production.up.railway.app
NEXT_PUBLIC_CALL_CENTER_URL=https://call-center-production.up.railway.app
NEXT_PUBLIC_COMPLIANCE_URL=https://compliance-production.up.railway.app
NEXT_PUBLIC_DEVELOPER_API_URL=https://developer-api-production.up.railway.app
NEXT_PUBLIC_FLOW_BUILDER_URL=https://flow-builder-production.up.railway.app
NEXT_PUBLIC_INTEGRATIONS_URL=https://integrations-production.up.railway.app
NEXT_PUBLIC_SETTINGS_URL=https://settings-production.up.railway.app
NEXT_PUBLIC_VOICE_LAB_URL=https://voice-lab-production.up.railway.app
NEXT_PUBLIC_VOICE_MARKETPLACE_URL=https://voice-marketplace-production.up.railway.app
NEXT_PUBLIC_WHITE_LABEL_URL=https://white-label-production-ab67.up.railway.app

# API Configuration
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3

# Authentication (these should be kept private - remove NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=your_database_url_here
REDIS_URL=your_redis_url_here
JWT_SECRET_KEY=your_jwt_secret_here

# Security
NEXT_PUBLIC_CORS_ORIGINS=*
NEXT_PUBLIC_RATE_LIMIT_ENABLED=true

# Features Flags for World-Class Services
NEXT_PUBLIC_FEATURE_KNOWLEDGE_BASE=true
NEXT_PUBLIC_FEATURE_LEAD_MANAGEMENT=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_SCHEDULING=true
NEXT_PUBLIC_FEATURE_SCRIPTS=true
NEXT_PUBLIC_FEATURE_WEBHOOKS=true

# Service Health Check URLs
NEXT_PUBLIC_HEALTH_CHECK_INTERVAL=30000
NEXT_PUBLIC_HEALTH_CHECK_TIMEOUT=10000
